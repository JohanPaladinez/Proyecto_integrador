// =====================================================
// RGB
// =====================================================

void setRGB(bool r, bool g, bool b) {

  digitalWrite(LED_R_PIN, r);

  digitalWrite(LED_G_PIN, g);

  digitalWrite(LED_B_PIN, b);
}

// =====================================================
// RELAYS
// =====================================================

void setRelay(bool on) {

  bool activeState =
    RELAY_ACTIVE_HIGH ? HIGH : LOW;

  bool inactiveState =
    RELAY_ACTIVE_HIGH ? LOW : HIGH;

  digitalWrite(
    RELAY1_PIN,
    on ? activeState : inactiveState
  );

  digitalWrite(
    RELAY2_PIN,
    on ? activeState : inactiveState
  );
}

