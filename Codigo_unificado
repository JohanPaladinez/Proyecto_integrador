void registrarTemperatura(float temperatura, const char* detalle) {
  if (!sdDisponible) {
    return;
  }

  char fecha[11];
  char hora[9];

  fechaHoraActual(
    fecha,
    sizeof(fecha),
    hora,
    sizeof(hora)
  );

  File file =
    SD_MMC.open(TEMP_PATH, FILE_APPEND);

  if (!file) {
    Serial.println("Error al abrir archivo temperatura");
    return;
  }

  file.print(fecha);
  file.print(",");
  file.print(hora);
  file.print(",");
  file.print(temperatura, 2);
  file.print(",");
  file.println(detalle);

  file.close();
}

