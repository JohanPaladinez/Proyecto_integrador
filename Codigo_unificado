void crearArchivoSiNoExiste(const char* path, const char* cabecera) {

  if (!SD_MMC.exists(path)) {

    File file = SD_MMC.open(path, FILE_WRITE);

    if (file) {

      file.println(cabecera);

      file.close();

    } else {

      Serial.println("Error al crear archivo SD");
    }
  }
}

void iniciarSD() {

  // Modo 1 bit para usar menos pines del ESP32.
  if (!SD_MMC.begin("/sdcard", true)) {

    Serial.println("Error al montar SD_MMC");

    sdDisponible = false;

    return;
  }

  sdDisponible = true;

  Serial.println("SD_MMC montada");

  crearArchivoSiNoExiste(TEMP_PATH, "Fecha,Hora,Temperatura_C,Detalle");

  crearArchivoSiNoExiste(CICLOS_PATH, "Fecha,Hora,Evento,Estado,Ciclo,Detalle");

  crearArchivoSiNoExiste(ALERTAS_PATH,"Fecha,Hora,Descripcion,Detalle");
}

// =====================================================
// TIEMPO RTC
// =====================================================

uint32_t segundosTranscurridos() {

  RtcDateTime ahora = rtc.GetDateTime();

  return ahora.TotalSeconds() -
         inicioEstado.TotalSeconds();
}

// =====================================================
// BOTON
// =====================================================

void gestionarBoton() {

  static bool last = HIGH;

  bool now = digitalRead(BUTTON_PIN);

  if (last == HIGH && now == LOW && estadoActual == ESPERA) {

    if (millis() - tUltimoBoton > DEBOUNCE_MS) {

      tUltimoBoton = millis();

      Serial.println("INICIO LIMPIEZA POR BOTON");

      cicloLimpieza++;

      estadoActual = LIMPIANDO;

      inicioEstado = rtc.GetDateTime();

      enviarCicloBD("INICIO_LIMPIEZA_BOTON", "Boton presionado en espera");
    }
  }

  last = now;
}

// =====================================================
// CICLO PRINCIPAL
// =====================================================

void gestionarCiclo() {

  uint32_t elapsed = segundosTranscurridos();

  switch (estadoActual) {

    case ESPERA:

      setRGB(1,0,0);

      setRelay(false);

      if (elapsed >= TIEMPO_ESPERA_S) {

        estadoActual = LIMPIANDO;

        inicioEstado = rtc.GetDateTime();

        cicloLimpieza++;

        Serial.println("LIMPIANDO");

        enviarCicloBD("INICIO_LIMPIEZA_AUTO", "Tiempo de espera cumplido");
      }

      break;

    case LIMPIANDO:

      setRGB(0,0,1);

      setRelay(true);

      if (elapsed >= TIEMPO_LIMPIEZA_S) {

        estadoActual = FINALIZADO;

        inicioEstado = rtc.GetDateTime();

        Serial.println("FINALIZADO");

        enviarCicloBD("FIN_LIMPIEZA", "Tiempo de limpieza cumplido");
      }

      break;

    case FINALIZADO:

      setRGB(0,1,0);

      setRelay(false);

      if (elapsed >= TIEMPO_FINAL_S) {

        estadoActual = ESPERA;

        inicioEstado = rtc.GetDateTime();

        Serial.println("ESPERA");

        enviarCicloBD("ESPERA", "Ciclo finalizado");
      }

      break;
  }
}

// =====================================================
// WIFI
// =====================================================

void conectarWiFi() {

  Serial.println(
    "Conectando WiFi"
  );

  WiFi.disconnect(true);

  delay(1000);

  WiFi.mode(WIFI_STA);

  WiFi.begin(ssid, password);

  WiFi.setSleep(false);

  unsigned long inicio = millis();

  while (
    WiFi.status() != WL_CONNECTED && millis() - inicio < 15000) {

    delay(500);

    Serial.print(".");
  }

  if (WiFi.status() == WL_CONNECTED) {

    Serial.println("\nWiFi conectado");

    Serial.print("IP: ");

    Serial.println(WiFi.localIP());

  } else {

    Serial.println("\nERROR WIFI");
  }
}

// =====================================================
// TEMPERATURA + HTTP
// =====================================================

void gestionarWiFiPost() {

  // Esperar tiempo entre POST

  if (!esperandoConversion && millis() - tUltimoPost < TIEMPO_POST_MS) {
    return;
  }

  // Iniciar conversion DS18B20

  if (!esperandoConversion) {

    sensors.requestTemperatures();

    esperandoConversion = true;

    tSolicitudTemp = millis();

    return;
  }

  // Esperar conversion completa

  if (millis() - tSolicitudTemp < 750) {
    return;
  }

  esperandoConversion = false;

  tUltimoPost = millis();

  float temperatura = sensors.getTempCByIndex(0);

  // Sensor desconectado

  if (temperatura == DEVICE_DISCONNECTED_C) {

    Serial.println("Error DS18B20");

    enviarAlertaBD("Falla sensor temperatura DS18B20 desconectado");

    return;
  }

  // Filtrado basico

  if (temperatura < -20.0f || temperatura > 120.0f) {

    Serial.println("Temperatura invalida");

    enviarAlertaBD("Falla sensor temperatura lectura invalida");

    return;
  }

  Serial.print("Temp: ");

  Serial.println(temperatura);

  // Verificar WiFi

  if (WiFi.status() != WL_CONNECTED) {

    Serial.println("Reconectando WiFi");

    conectarWiFi();

    if (WiFi.status() != WL_CONNECTED) {

      registrarTemperatura(temperatura, "Respaldo SD: WiFi desconectado");

      return;
    }
  }

  HTTPClient http;

  http.begin(serverName);

  http.setTimeout(3000);

  http.addHeader("Content-Type", "application/x-www-form-urlencoded");

  char payload[128];
  char fecha[11];
  char hora[9];

  fechaHoraActual(
    fecha,
    sizeof(fecha),
    hora,
    sizeof(hora)
  );

  snprintf(
    payload,
    sizeof(payload),
    "temperatura=%.2f&fecha_hora=%s+%s",
    temperatura,
    fecha,
    hora
  );

  int httpCode = http.POST(payload);

  Serial.print("HTTP: ");

  Serial.println(httpCode);

  http.end();

  if (httpCode < 200 || httpCode >= 300) {

    registrarTemperatura(temperatura, "Respaldo SD: fallo HTTP");
  }
}

// =====================================================
// SINCRONIZACION SD
// =====================================================

void iniciarSincronizacion() {
  if (!sdDisponible || WiFi.status() != WL_CONNECTED) return;
  if (estadoSync != SYNC_NINGUNO) return;

  File f = SD_MMC.open(TEMP_PATH, FILE_READ);
  if (f) {
    if (f.size() > 50) {
      f.close();
      if (SD_MMC.exists(TEMP_SYNC_PATH)) SD_MMC.remove(TEMP_SYNC_PATH);
      SD_MMC.rename(TEMP_PATH, TEMP_SYNC_PATH);
      crearArchivoSiNoExiste(TEMP_PATH, "Fecha,Hora,Temperatura_C,Detalle");
    } else {
      f.close();
    }
  }

  f = SD_MMC.open(CICLOS_PATH, FILE_READ);
  if (f) {
    if (f.size() > 50) {
      f.close();
      if (SD_MMC.exists(CICLOS_SYNC_PATH)) SD_MMC.remove(CICLOS_SYNC_PATH);
      SD_MMC.rename(CICLOS_PATH, CICLOS_SYNC_PATH);
      crearArchivoSiNoExiste(CICLOS_PATH, "Fecha,Hora,Evento,Estado,Ciclo,Detalle");
    } else {
      f.close();
    }
  }

  f = SD_MMC.open(ALERTAS_PATH, FILE_READ);
  if (f) {
    if (f.size() > 50) {
      f.close();
      if (SD_MMC.exists(ALERTAS_SYNC_PATH)) SD_MMC.remove(ALERTAS_SYNC_PATH);
      SD_MMC.rename(ALERTAS_PATH, ALERTAS_SYNC_PATH);
      crearArchivoSiNoExiste(ALERTAS_PATH, "Fecha,Hora,Descripcion,Detalle");
    } else {
      f.close();
    }
  }

  if (SD_MMC.exists(TEMP_SYNC_PATH)) {
     estadoSync = SYNC_TEMPERATURA;
     archivoSync = SD_MMC.open(TEMP_SYNC_PATH, FILE_READ);
     if (archivoSync) archivoSync.readStringUntil('\n');
  } else if (SD_MMC.exists(CICLOS_SYNC_PATH)) {
     estadoSync = SYNC_CICLOS;
     archivoSync = SD_MMC.open(CICLOS_SYNC_PATH, FILE_READ);
     if (archivoSync) archivoSync.readStringUntil('\n');
  } else if (SD_MMC.exists(ALERTAS_SYNC_PATH)) {
     estadoSync = SYNC_ALERTAS;
     archivoSync = SD_MMC.open(ALERTAS_SYNC_PATH, FILE_READ);
     if (archivoSync) archivoSync.readStringUntil('\n');
  }
}

void procesarSincronizacion() {
  if (estadoSync == SYNC_NINGUNO) return;
  if (millis() - tUltimoSync < INTERVALO_SYNC_MS) return;
  if (WiFi.status() != WL_CONNECTED) return;

  if (!archivoSync || !archivoSync.available()) {
     if (archivoSync) archivoSync.close();
     
     if (estadoSync == SYNC_TEMPERATURA) {
        SD_MMC.remove(TEMP_SYNC_PATH);
        if (SD_MMC.exists(CICLOS_SYNC_PATH)) {
            estadoSync = SYNC_CICLOS;
            archivoSync = SD_MMC.open(CICLOS_SYNC_PATH, FILE_READ);
            if (archivoSync) archivoSync.readStringUntil('\n');
        } else if (SD_MMC.exists(ALERTAS_SYNC_PATH)) {
            estadoSync = SYNC_ALERTAS;
            archivoSync = SD_MMC.open(ALERTAS_SYNC_PATH, FILE_READ);
            if (archivoSync) archivoSync.readStringUntil('\n');
        } else {
            estadoSync = SYNC_NINGUNO;
        }
     } else if (estadoSync == SYNC_CICLOS) {
        SD_MMC.remove(CICLOS_SYNC_PATH);
        if (SD_MMC.exists(ALERTAS_SYNC_PATH)) {
            estadoSync = SYNC_ALERTAS;
            archivoSync = SD_MMC.open(ALERTAS_SYNC_PATH, FILE_READ);
            if (archivoSync) archivoSync.readStringUntil('\n');
        } else {
            estadoSync = SYNC_NINGUNO;
        }
     } else if (estadoSync == SYNC_ALERTAS) {
        SD_MMC.remove(ALERTAS_SYNC_PATH);
        estadoSync = SYNC_NINGUNO;
     }
     return;
  }

  String linea = archivoSync.readStringUntil('\n');
  linea.trim();
  if (linea.length() == 0) return;

  int coma1 = linea.indexOf(',');
  int coma2 = linea.indexOf(',', coma1 + 1);
  if (coma1 <= 0 || coma2 <= 0) return;

  String fecha = linea.substring(0, coma1);
  String hora = linea.substring(coma1 + 1, coma2);
  String payload = "";

  if (estadoSync == SYNC_TEMPERATURA) {
      int coma3 = linea.indexOf(',', coma2 + 1);
      if (coma3 > 0) {
          String temp = linea.substring(coma2 + 1, coma3);
          payload = "temperatura=" + temp + "&fecha_hora=" + fecha + "+" + hora;
      }
  } else if (estadoSync == SYNC_CICLOS) {
      int coma3 = linea.indexOf(',', coma2 + 1);
      int coma4 = linea.indexOf(',', coma3 + 1);
      int coma5 = linea.indexOf(',', coma4 + 1);
      if (coma3 > 0 && coma4 > 0 && coma5 > 0) {
          String evento = linea.substring(coma2 + 1, coma3);
          String ciclo = linea.substring(coma4 + 1, coma5);
          String detalle = linea.substring(coma5 + 1);
          
          if (evento == "INICIO_LIMPIEZA_BOTON" || evento == "INICIO_LIMPIEZA_AUTO") {
              String tipoModo = (evento == "INICIO_LIMPIEZA_BOTON") ? "manual" : "automatico";
              payload = "tipo=inicio_limpieza&fecha_hora=" + fecha + "+" + hora + "&tipo_modo=" + tipoModo + "&ciclo=" + ciclo + "&detalle=" + urlEncode(detalle.c_str());
          } else {
              return;
          }
      }
  } else if (estadoSync == SYNC_ALERTAS) {
      int coma3 = linea.indexOf(',', coma2 + 1);
      if (coma3 > 0) {
          String desc = linea.substring(coma2 + 1, coma3);
          payload = "tipo=alerta&fecha_hora=" + fecha + "+" + hora + "&descripcion=" + urlEncode(desc.c_str());
      }
  }

  if (payload.length() > 0) {
      HTTPClient http;
      http.begin(serverName);
      http.setTimeout(3000);
      http.addHeader("Content-Type", "application/x-www-form-urlencoded");
      int httpCode = http.POST(payload);
      Serial.print("Sync HTTP: "); Serial.println(httpCode);
      http.end();
  }
  
  tUltimoSync = millis();
}

// =====================================================
// SETUP
// =====================================================

void setup() {

  Serial.begin(115200);

  // =========================
  // RTC DS1302
  // =========================

  rtc.Begin();

  if (rtc.GetIsWriteProtected()) {

    rtc.SetIsWriteProtected(false);
  }

  if (!rtc.GetIsRunning()) {

    rtc.SetIsRunning(true);
  }

  // Ajustar solo la primera vez si el RTC no tiene hora valida.
  // Despues de cargar y verificar, volver a comentar esta linea.
  //
  // rtc.SetDateTime(RtcDateTime(__DATE__, __TIME__));

  if (!rtc.IsDateTimeValid()) {

    Serial.println("RTC DS1302 sin fecha valida");
  }

  // =========================
  // PINES
  // =========================

  pinMode(RELAY1_PIN, OUTPUT);

  pinMode(RELAY2_PIN, OUTPUT);

  pinMode(BUTTON_PIN, INPUT_PULLUP);

  pinMode(LED_R_PIN, OUTPUT);

  pinMode(LED_G_PIN, OUTPUT);

  pinMode(LED_B_PIN, OUTPUT);

  // =========================
  // ESTADOS INICIALES
  // =========================

  setRelay(false);

  setRGB(0,0,0);

  // =========================
  // DS18B20
  // =========================

  sensors.begin();

  sensors.setResolution(12);

  // Evita bloqueo de 750 ms

  sensors.setWaitForConversion(false);

  // =========================
  // SD
  // =========================

  iniciarSD();

  // =========================
  // WIFI
  // =========================

  conectarWiFi();

  // =========================
  // ESTADO INICIAL
  // =========================

  estadoActual = ESPERA;

  inicioEstado = rtc.GetDateTime();

  Serial.println("SISTEMA INICIADO");

  enviarCicloBD("SISTEMA_INICIADO", "Inicio del ESP32");
}

// =====================================================
// LOOP
// =====================================================

void loop() {

  gestionarBoton();

  gestionarCiclo();

  gestionarWiFiPost();

  iniciarSincronizacion();

  procesarSincronizacion();

  delay(1);
}
