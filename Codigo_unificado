String urlEncode(const char* texto) {

  String encoded = "";

  while (*texto) {

    char c = *texto++;

    if ((c >= 'A' && c <= 'Z') ||
        (c >= 'a' && c <= 'z') ||
        (c >= '0' && c <= '9') ||
        c == '-' ||
        c == '_' ||
        c == '.' ||
        c == '~') {

      encoded += c;

    } else if (c == ' ') {

      encoded += '+';

    } else {

      char hex[4];

      snprintf(
        hex,
        sizeof(hex),
        "%%%02X",
        (uint8_t)c
      );

      encoded += hex;
    }
  }

  return encoded;
}

void enviarCicloBD(const char* evento, const char* detalle) {
  const char* tipoModo = "";
  if (strcmp(evento, "INICIO_LIMPIEZA_BOTON") == 0) {
    tipoModo = "manual";
  } else if (strcmp(evento, "INICIO_LIMPIEZA_AUTO") == 0) {
    tipoModo = "automatico";
  } else {
    return;
  }

  if (WiFi.status() != WL_CONNECTED) {

    Serial.println("Reconectando WiFi para ciclo");
    conectarWiFi();

    if (WiFi.status() != WL_CONNECTED) {
      registrarCiclo(evento, "Respaldo SD: WiFi desconectado");
      return;
    }
  }

  char fecha[11];
  char hora[9];

  fechaHoraActual(
    fecha,
    sizeof(fecha),
    hora,
    sizeof(hora)
  );

  HTTPClient http;

  http.begin(serverName);

  http.setTimeout(3000);

  http.addHeader("Content-Type", "application/x-www-form-urlencoded");

  String payload =
    String("tipo=inicio_limpieza") +
    "&fecha_hora=" + String(fecha) + "+" + String(hora) +
    "&tipo_modo=" + String(tipoModo) +
    "&ciclo=" + String(cicloLimpieza) +
    "&detalle=" + urlEncode(detalle);

  int httpCode = http.POST(payload);

  Serial.print("HTTP ciclo: ");

  Serial.println(httpCode);

  http.end();

  if (httpCode < 200 || httpCode >= 300) {

    registrarCiclo(evento, "Respaldo SD: fallo HTTP");
  }
}

void enviarAlertaBD(const char* descripcion) {

  if (WiFi.status() != WL_CONNECTED) {

    Serial.println("Reconectando WiFi para alerta");

